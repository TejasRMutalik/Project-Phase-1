# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Database files
*.sqlite
*.sqlite3
*.db

# Environment & local settings
.env
.env.local

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Large demo asset downloads - refetch via frontend/download_videos.ps1
frontend/assets/videos/*.mp4

# Fetchable/runtime artifacts - not source
backend/weights/
backend/assets/
backend/uploads/

# Training data & run output - not source
# Ignore dataset *contents* (not the dir itself) so traffic_data.yaml can be
# re-included - a negation under a fully-excluded dir would be a no-op.
backend/dataset/*
!backend/dataset/traffic_data.yaml
backend/runs/

# Next.js and frontend dependencies
node_modules/
.next/
frontend/node_modules/
frontend/.next/

